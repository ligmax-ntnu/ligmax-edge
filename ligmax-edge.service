# Runs update.py, which runs run.sh and pulls when the dashboard asks.
#
# Install (copy as-is; User and WorkingDirectory below already match the account
# the Jetson image ships with, jadmin. They used to say `ligmax`, a user that does
# not exist on the board: systemd cannot resolve it, so every start died at
# 217/USER before a line of Python ran, and Restart=always turned that into a
# 10-second reboot loop. If you do run this under a different account, change both
# lines together and make sure that account is in the `video` group.):
#   sudo cp ligmax-edge.service /etc/systemd/system/
#   sudo mkdir -p /etc/ligmax
#   sudo tee /etc/ligmax/node.env >/dev/null <<'EOF'
#   LIGMAX_DEPLOY_URL=https://live.ligmax.no
#   LIGMAX_NODE_KEY=<LIGMAX_NODE_KEY from ligmax-server/.env>
#   LIGMAX_BOAT_KEY=<this boat's ingest key from ligmax-server/.env>
#   EOF
#
# LIGMAX_BOAT_KEY is what cloud_camera.py authenticates the dashboard uplink
# with, and without it BOTH `GET /api/camera/config` and `POST /api/camera` are
# refused: video never switches on, no frame is ever sent, and the panel reports
# "the Jetson has never asked for the config" -- which reads as a dead board.
# It is the same key the Pi uses (ligmax-pi.service), because it is the same
# trust boundary.
#
# HOST and PORT are deliberately NOT set here. run.sh already defaults them to
# ligmax-pi3.local:3401, which is where the Pi binds; setting them overrides that
# default, and the pair this file used to carry (192.168.99.135:3338) was a bench
# laptop on the port the dashboard owns. Set them only for bench work against a
# receiver.py, and per-run rather than in this file:
#   HOST=192.168.1.50 PORT=3401 ./run.sh
#   sudo chmod 640 /etc/ligmax/node.env
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ligmax-edge
#
# `enable` is the word that matters: it is what makes this come back after a power
# cycle. `start` alone lasts until the next reboot. Check it took:
#   systemctl is-enabled ligmax-edge      -> enabled
#   journalctl -u ligmax-edge -f

[Unit]
Description=Ligmax edge perception (run.sh) + updater
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jadmin
WorkingDirectory=/home/jadmin/ligmax-edge
# HOST and PORT are read by run.sh and decide where the video stream is sent.
EnvironmentFile=/etc/ligmax/node.env
ExecStart=/usr/bin/python3 update.py

# The cameras can come up before the CSI stack is ready after a cold boot, and
# run.sh exits rather than serving an empty feed. update.py retries it every 5 s;
# this line covers the supervisor itself dying.
Restart=always
RestartSec=10

# The Jetson needs the video devices.
SupplementaryGroups=video

[Install]
WantedBy=multi-user.target
